<?xml version="1.0" encoding="utf-8"?>
<!-- baris pilihan mode: kepilih = garis hijau -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1A00A884" />
            <stroke android:width="1.5dp" android:color="@color/wr_hijau" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/wr_kartu2" />
            <stroke android:width="1dp" android:color="@color/wr_garis" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/wr_input" />
            <stroke android:width="1dp" android:color="@color/wr_garis" />
        </shape>
    </item>
</selector>
