<?xml version="1.0" encoding="utf-8"?>
<!--
  Catatan soal ikon:
  Semua ikon di layar ini gambar VEKTOR (@drawable/ic_*), bukan emoji.
  Emoji (▶️ ⏸️ 💾 dst) dirender beda-beda di tiap HP — ada yang kotak kosong,
  ada yang jadi warna aneh, dan ukurannya nggak bisa diatur. Vektor aman
  karena warnanya diambil dari tema (app:tint / app:iconTint), jadi otomatis
  ikut terang/gelap.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= STATUS ================= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_logo"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/app_name"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="Service : mati&#10;Engine  : —&#10;WA      : —&#10;Channel : —&#10;Terakhir: —"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= SETTING ================= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_setelan"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Setting"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Repo GitHub (owner/nama-repo)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRepo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--
                  Yang diterima: LINK channel (https://whatsapp.com/channel/0029...),
                  atau JID <angka>@newsletter, atau grup <angka>@g.us.
                  Username (@nama) TIDAK bisa dipakai — engine-nya nggak punya
                  API buat nyari channel dari username. Tekan "Bikin Channel"
                  kalau belum punya channel.
                -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Channel WA (tempel LINK channel-nya)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etChannel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Buka channel-nya di WA → ⋯ → Bagikan → salin link-nya, tempel di atas. Belum punya channel? Tekan Bikin Channel — bot yang bikinin, lalu ngisi kolom ini otomatis."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBikinChannel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bikin Channel"
                    app:icon="@drawable/ic_tambah"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Token GitHub (opsional — repo private / anti rate limit)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Interval cek (menit)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cbPrerelease"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sertakan prerelease / beta"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbPostFirst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Posting release pertama saat first run"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbTestMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Kirim test message saat setup"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbBoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mulai otomatis saat HP boot"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Simpan Setting"
                    app:icon="@drawable/ic_simpan"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="?attr/colorOnPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= AKSI ================= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_kontrol"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Kontrol"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mulai"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="?attr/colorOnPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Jeda"
                        app:icon="@drawable/ic_jeda"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="?attr/colorOnSecondaryContainer" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheck"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cek Sekarang"
                        app:icon="@drawable/ic_cek"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="?attr/colorOnPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTest"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Test"
                        app:icon="@drawable/ic_kirim"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="?attr/colorOnSecondaryContainer" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Setup (Scan QR)"
                        app:icon="@drawable/ic_qr"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="?attr/colorOnPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKill"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Matikan Service"
                        android:textColor="#D32F2F"
                        app:icon="@drawable/ic_power"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="#D32F2F" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Setup cuma 1x seumur hidup: nampilin QR, lo scan pakai WA, bot kirim test message ke channel &amp; catat baseline release."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= LOG ================= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_log"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Log"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="40 baris terakhir. Rekaman lengkapnya (termasuk penyebab kalau app mati sendiri) ada di file:"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvFolderLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="(folder log)"
                    android:textIsSelectable="true"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBukaLog"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Buka Folder Log"
                        app:icon="@drawable/ic_folder"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="?attr/colorOnSecondaryContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKirimLog"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Kirim Log"
                        app:icon="@drawable/ic_bagi"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="?attr/colorOnSecondaryContainer" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/svLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxHeight="240dp">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="(belum ada aktivitas)"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
