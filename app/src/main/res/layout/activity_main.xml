<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar utama. Semua komponen digambar sendiri (lihat res/values/themes.xml
  + res/drawable/bg_*): nggak ada MaterialButton / CardView / Switch bawaan.
  "Tombol" = TextView yang bisa diklik, "saklar" = baris yang di-set
  isSelected (gambar saklarnya ikut lewat selector).
  File ini dibikin rapi pakai generator, tapi boleh diedit langsung.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wr_latar">

    <!-- Tarik dari atas ke bawah = segerin status (tanpa nautin ulang). -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/segarkan"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/svUtama"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp">

            <!-- ================= HEADER ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_logo">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_logo" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/wr_teks"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvVersi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="rilis GitHub → WhatsApp"
                        android:textColor="@color/wr_teks2"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="MATI"
                    android:textColor="@color/wr_teks"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ================= STATUS ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <LinearLayout style="@style/Ubin">
                    <TextView style="@style/UbinLabel" android:text="WhatsApp" />
                    <TextView android:id="@+id/tvUbinWa" style="@style/UbinIsi" android:text="—" />
                </LinearLayout>
                <LinearLayout style="@style/Ubin"
                    android:layout_marginStart="10dp">
                    <TextView style="@style/UbinLabel" android:text="Engine" />
                    <TextView android:id="@+id/tvUbinEngine" style="@style/UbinIsi" android:text="—" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <LinearLayout style="@style/Ubin">
                    <TextView style="@style/UbinLabel" android:text="Rilis terakhir" />
                    <TextView android:id="@+id/tvUbinRilis" style="@style/UbinIsi" android:text="—" />
                </LinearLayout>
                <LinearLayout style="@style/Ubin"
                    android:layout_marginStart="10dp">
                    <TextView style="@style/UbinLabel" android:text="Penjaga grup" />
                    <TextView android:id="@+id/tvUbinGrup" style="@style/UbinIsi" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/wr_teks2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tombol_bahaya"
                android:padding="12dp"
                android:textColor="@color/wr_merah"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnMulai"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/TombolUtama"
                    android:drawableStart="@drawable/ic_play"
                    android:text="Mulai" />
                <TextView
                    android:id="@+id/btnCheck"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    style="@style/TombolGaris"
                    android:drawableStart="@drawable/ic_cek"
                    android:text="Cek sekarang" />
            </LinearLayout>

            <!-- ================= TAUTKAN WA ================= -->
            <LinearLayout style="@style/Kartu">
            <TextView
                style="@style/JudulKartu"
                android:drawableStart="@drawable/ic_tautan"
                android:text="Tautkan WhatsApp" />
            <TextView android:id="@+id/tvKetTaut" style="@style/KetKartu" android:text="Cukup sekali. Paling gampang pakai kode: isi nomor WA lo, nanti muncul 8 huruf yang diketik di WhatsApp — nggak perlu HP kedua buat scan QR." />
            <TextView
                android:id="@+id/tvWaStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/wr_hijau"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tvLabelPhone" style="@style/Label" android:text="Nomor WA (buat pairing code)" />
            <EditText
                android:id="@+id/etPhone"
                style="@style/Isian"
                android:hint="contoh: 0812 3456 7890"
                android:importantForAutofill="no"
                android:inputType="phone" />
            <TextView
                android:id="@+id/btnPairing"
                style="@style/TombolUtama"
                android:drawableStart="@drawable/ic_kunci"
                android:text="Tautkan pakai kode"
                android:layout_marginTop="12dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnQr"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/TombolGaris"
                    android:drawableStart="@drawable/ic_qr"
                    android:text="Pakai QR" />
                <TextView
                    android:id="@+id/btnLepas"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_tutup"
                    android:text="Lepas WA" />
            </LinearLayout>
            </LinearLayout>

            <!-- ================= RILIS → CHANNEL ================= -->
            <LinearLayout style="@style/Kartu">
            <TextView
                style="@style/JudulKartu"
                android:drawableStart="@drawable/ic_kirim"
                android:text="Rilis GitHub → Channel" />
            <TextView style="@style/KetKartu" android:text="Tiap ada rilis baru di repo, bot posting ke channel / grup WA. Kosongin repo kalau cuma mau pakai penjaga grup." />
            <TextView style="@style/Label" android:text="Repo GitHub" />
            <EditText
                android:id="@+id/etRepo"
                style="@style/Isian"
                android:hint="pemilik/nama-repo"
                android:importantForAutofill="no" />
            <TextView style="@style/Label" android:text="Channel WA" />
            <EditText
                android:id="@+id/etChannel"
                style="@style/Isian"
                android:hint="link channel / JID / link grup"
                android:importantForAutofill="no" />
            <TextView style="@style/Label" android:text="Token GitHub (opsional)" />
            <EditText
                android:id="@+id/etToken"
                style="@style/Isian"
                android:hint="kosongin kalau repo publik"
                android:importantForAutofill="no"
                android:inputType="textPassword" />
            <TextView style="@style/Label" android:text="Cek tiap (menit)" />
            <EditText
                android:id="@+id/etInterval"
                style="@style/Isian"
                android:hint="15"
                android:importantForAutofill="no"
                android:inputType="number" />
            <LinearLayout android:id="@+id/rowPrerelease" style="@style/BarisSaklar">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ikutkan pre-release"
                        android:textColor="@color/wr_teks"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Versi beta / RC ikut diposting"
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView style="@style/Saklar" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowPostFirst" style="@style/BarisSaklar">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Posting rilis yang ada sekarang"
                        android:textColor="@color/wr_teks"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Pas pertama jalan, langsung posting rilis terakhir"
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView style="@style/Saklar" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowTestMsg" style="@style/BarisSaklar">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kirim pesan tes pas setup"
                        android:textColor="@color/wr_teks"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Biar ketahuan channel-nya bener"
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView style="@style/Saklar" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowFormatTanya" style="@style/BarisSaklar">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kirim sebagai Pertanyaan"
                        android:textColor="@color/wr_teks"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Follower channel bisa bales pesan rilis (balasannya cuma sampai ke lo). Matiin kalau di WA-nya tampil aneh."
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView style="@style/Saklar" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnBikinChannel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_tambah"
                    android:text="Bikin channel" />
                <TextView
                    android:id="@+id/btnTest"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_kirim"
                    android:text="Tes kirim ke channel" />
            </LinearLayout>
            </LinearLayout>

            <!-- ================= PENJAGA GRUP ================= -->
            <LinearLayout style="@style/Kartu">
            <TextView
                style="@style/JudulKartu"
                android:drawableStart="@drawable/ic_perisai"
                android:text="Penjaga grup" />
            <TextView style="@style/KetKartu" android:text="Buat grup yang pakai &quot;Setujui anggota baru&quot;: yang minta join otomatis di-approve, KECUALI yang dulu udah keluar / dikeluarin — mereka ditolak. Akun WA lo harus admin di grup itu." />
            <LinearLayout android:id="@+id/rowGrupAktif" style="@style/BarisSaklar">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nyalain penjaga grup"
                        android:textColor="@color/wr_teks"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cek permintaan join secara berkala"
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView style="@style/Saklar" />
            </LinearLayout>
            <TextView style="@style/Label" android:text="Link undangan grup" />
            <EditText
                android:id="@+id/etGrup"
                style="@style/Isian"
                android:hint="https://chat.whatsapp.com/…"
                android:importantForAutofill="no" />
            <TextView style="@style/Label" android:text="Cek tiap (menit, minimal 2)" />
            <EditText
                android:id="@+id/etGrupInterval"
                style="@style/Isian"
                android:hint="5"
                android:importantForAutofill="no"
                android:inputType="number" />
            <TextView style="@style/Label" android:text="Selalu tolak nomor ini (opsional)" />
            <EditText
                android:id="@+id/etGrupHitam"
                style="@style/Isian"
                android:hint="pisahin pakai koma / baris baru"
                android:importantForAutofill="no"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:singleLine="false" />
            <TextView
                style="@style/KetKartu"
                android:layout_marginTop="6dp"
                android:text="Yang keluar SEBELUM fitur ini nyala nggak ketahuan sama bot — masukin nomornya di sini." />
            <TextView
                android:id="@+id/tvGrupStat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ubin"
                android:padding="12dp"
                android:textColor="@color/wr_teks"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnCekGrup"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/TombolGaris"
                    android:drawableStart="@drawable/ic_cek"
                    android:text="Cek sekarang" />
                <TextView
                    android:id="@+id/btnTesGrup"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    style="@style/TombolGaris"
                    android:drawableStart="@drawable/ic_kirim"
                    android:text="Tes kirim" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnLihatHitam"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_daftar"
                    android:text="Daftar hitam" />
                <TextView
                    android:id="@+id/btnResetHitam"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_hapus"
                    android:text="Kosongin" />
            </LinearLayout>
            </LinearLayout>

            <!-- ================= LAGU MOOD ================= -->
            <LinearLayout style="@style/Kartu">
            <TextView
                style="@style/JudulKartu"
                android:drawableStart="@drawable/ic_lagu"
                android:text="Lagu mood" />
            <TextView style="@style/KetKartu" android:text="Sesekali bot ngirim potongan lagu lama (~60 dtk) + kata-kata ke channel. Jadwalnya diacak kayak orang lagi mood — nggak tiap jam, nggak spam. Cloudflare yang nyariin lagunya; HP cuma download potongan ±1 MB, kirim, terus file-nya langsung dihapus." />
            <LinearLayout android:id="@+id/rowLaguAktif" style="@style/BarisSaklar">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nyalain lagu mood"
                        android:textColor="@color/wr_teks"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dikirim ke channel yang sama kayak rilis"
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView style="@style/Saklar" />
            </LinearLayout>
            <TextView style="@style/Label" android:text="Rata-rata berapa kali sehari (1–8)" />
            <EditText
                android:id="@+id/etLaguPerHari"
                style="@style/Isian"
                android:hint="2"
                android:inputType="number" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Label" android:text="Mulai jam" />
                    <EditText
                        android:id="@+id/etLaguJamMulai"
                        style="@style/Isian"
                        android:hint="9"
                        android:inputType="number" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Label" android:text="Sampai jam" />
                    <EditText
                        android:id="@+id/etLaguJamSelesai"
                        style="@style/Isian"
                        android:hint="22"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/tvLaguStat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ubin"
                android:padding="12dp"
                android:textColor="@color/wr_teks"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/btnLaguSekarang"
                style="@style/TombolGaris"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_lagu"
                android:text="Kirim satu lagu sekarang" />
            </LinearLayout>

            <!-- ================= HOSTING BOT ================= -->
            <LinearLayout style="@style/Kartu">
            <TextView
                style="@style/JudulKartu"
                android:drawableStart="@drawable/ic_server"
                android:text="Hosting bot lo sendiri" />
            <TextView style="@style/KetKartu" android:text="Punya project bot Node.js? Upload ZIP-nya, app ini yang jalanin di HP — lengkap sama konsol, input, restart otomatis." />
            <TextView
                android:id="@+id/tvHostingStat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ubin"
                android:padding="12dp"
                android:textColor="@color/wr_teks"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/btnHosting"
                style="@style/TombolUtama"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_server"
                android:text="Buka hosting" />
            </LinearLayout>

            <!-- ================= BATRE & NYALA OTOMATIS ================= -->
            <LinearLayout style="@style/Kartu">
            <TextView
                style="@style/JudulKartu"
                android:drawableStart="@drawable/ic_batre"
                android:text="Batre &amp; nyala otomatis" />
            <TextView style="@style/KetKartu" android:text="Bot-nya tidur hampir sepanjang waktu, cuma bangun sebentar pas jadwal cek. Biar nggak dibunuh sistem (apalagi di Xiaomi), izinkan dua hal di bawah." />
            <LinearLayout android:id="@+id/rowBoot" style="@style/BarisSaklar">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nyala otomatis pas HP nyala"
                        android:textColor="@color/wr_teks"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nggak perlu buka app habis restart"
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView style="@style/Saklar" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowLogcat" style="@style/BarisSaklar">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rekam log detail (debug)"
                        android:textColor="@color/wr_teks"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Matiin kalau udah lancar — sedikit lebih hemat"
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView style="@style/Saklar" />
            </LinearLayout>
            <TextView
                android:id="@+id/btnBatre"
                style="@style/TombolLembut"
                android:drawableStart="@drawable/ic_batre"
                android:text="Izinkan jalan di latar (batre)"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/btnAutostart"
                style="@style/TombolLembut"
                android:drawableStart="@drawable/ic_power"
                android:text="Buka izin Autostart (Xiaomi dll)"
                android:layout_marginTop="10dp" />
            <TextView
                android:id="@+id/tvBatreStat"
                style="@style/KetKartu"
                android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- ================= LOG ================= -->
            <LinearLayout style="@style/Kartu">
            <TextView
                style="@style/JudulKartu"
                android:drawableStart="@drawable/ic_log"
                android:text="Log" />
            <TextView style="@style/KetKartu" android:text="Catatan kerja bot. Kalau ada yang aneh, tekan Kirim log." />
            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_log"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="(belum ada log)"
                    android:textColor="#B8C4CA"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />
            </ScrollView>
            <TextView
                android:id="@+id/tvFolderLog"
                style="@style/KetKartu"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textSize="11sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnBukaLog"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_folder"
                    android:text="Buka folder" />
                <TextView
                    android:id="@+id/btnKirimLog"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_bagi"
                    android:text="Kirim log" />
            </LinearLayout>
            <TextView
                android:id="@+id/btnKill"
                style="@style/TombolBahaya"
                android:drawableStart="@drawable/ic_power"
                android:text="Matikan service"
                android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- ================= TENTANG ================= -->
            <LinearLayout style="@style/Kartu">
            <TextView
                style="@style/JudulKartu"
                android:text="Tentang" />
            <TextView
                android:id="@+id/tvTentang"
                style="@style/KetKartu"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/btnRepo"
                style="@style/TombolLembut"
                android:text="Buka repo GitHub"
                android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- footer paling bawah: BUILT IN XyVerse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.22"
                    android:text="BUILT IN"
                    android:textColor="@color/wr_teks2"
                    android:textSize="10.5sp" />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="XyVerse Tech"
                    android:src="@drawable/xyverse_logo" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ================= BANNER (pengganti Toast) ================= -->
    <TextView
        android:id="@+id/tvBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_banner"
        android:elevation="8dp"
        android:padding="14dp"
        android:textColor="@color/wr_teks"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ================= BAR SIMPAN ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F20B141A"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">
        <TextView
            android:id="@+id/btnSave"
            style="@style/TombolUtama"
            android:drawableStart="@drawable/ic_simpan"
            android:text="Simpan setting" />
    </FrameLayout>

    <!-- ================= SPLASH (animasi morph, ditutup begitu app siap) ================= -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wr_latar"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <com.xykals.warelease.MorphView
                android:id="@+id/morph"
                android:layout_width="200dp"
                android:layout_height="200dp" />
            <!-- tulisan di dalam gelembung chat, "pop" tiap ganti bentuk -->
            <LinearLayout
                android:id="@+id/gelembungSplash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="9dp"
                    android:layout_marginBottom="-1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ekor_gelembung" />
                <TextView
                    android:id="@+id/tvSplashLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gelembung"
                    android:elevation="3dp"
                    android:minWidth="170dp"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="11dp"
                    android:text="Bot penjaga siap"
                    android:textColor="@color/wr_teks"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:text="BUILT IN"
                android:textColor="@color/wr_teks2"
                android:textSize="10.5sp" />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="XyVerse Tech"
                android:src="@drawable/xyverse_logo" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
