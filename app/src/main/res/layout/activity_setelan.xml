<?xml version="1.0" encoding="utf-8"?>
<!--
  Setelan (SettingsActivity).
  DIBIKIN GENERATOR: scripts-dev/gen_layout.py — edit di sana, lalu jalankan ulang.
  Semua komponen digambar sendiri (res/values/themes.xml + res/drawable/bg_*):
  nggak ada MaterialButton / CardView / Switch bawaan.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wr_latar">

    <ScrollView
        android:id="@+id/svUtama"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/btnKembali"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_tombol_lembut"
                    android:clickable="true"
                    android:contentDescription="Kembali"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_kembali"
                    android:tint="@color/wr_teks" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Setelan"
                        android:textColor="@color/wr_teks"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvSetelanSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/wr_teks2"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Kartu">
                <TextView
                    style="@style/JudulKartu"
                    android:drawableStart="@drawable/ic_kirim"
                    android:text="Rilis GitHub" />
                <TextView style="@style/KetKartu" android:text="Tiap ada rilis baru di repo, bot posting ke channel WA. Kosongin repo kalau cuma mau pakai penjaga grup." />
                <TextView style="@style/Label" android:text="Repo GitHub" />
                <EditText
                    android:id="@+id/etRepo"
                    style="@style/Isian"
                    android:hint="pemilik/repo  atau  link github.com/..."
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
                <TextView style="@style/Label" android:text="Token GitHub (opsional)" />
                <EditText
                    android:id="@+id/etToken"
                    style="@style/Isian"
                    android:hint="ghp_… (cuma perlu buat repo privat)"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />
                <TextView style="@style/Label" android:text="Cek rilis tiap (menit)" />
                <EditText
                    android:id="@+id/etInterval"
                    style="@style/Isian"
                    android:hint="15"
                    android:importantForAutofill="no"
                    android:inputType="number" />
                <LinearLayout android:id="@+id/rowPrerelease" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ikutkan pre-release"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Versi beta / RC ikut diposting"
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowPostFirst" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Posting rilis yang ada sekarang"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pas pertama jalan, langsung posting rilis terakhir"
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Kartu">
                <TextView
                    style="@style/JudulKartu"
                    android:drawableStart="@drawable/ic_chat"
                    android:text="Channel WhatsApp" />
                <TextView style="@style/Label" android:text="Channel WA" />
                <EditText
                    android:id="@+id/etChannel"
                    style="@style/Isian"
                    android:hint="link whatsapp.com/channel/…  atau  …@newsletter"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
                <LinearLayout android:id="@+id/rowFormatTanya" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Kirim sebagai Pertanyaan"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Follower bisa bales; balasannya cuma sampai ke lo, bisa dibaca lewat &quot;Lihat respons&quot;. Matiin kalau channel-nya belum dapet fitur ini."
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowTestMsg" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Kirim pesan tes pas setup"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Biar ketahuan channel-nya bener"
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btnBikinChannel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_tambah"
                        android:text="Bikin channel" />
                    <TextView
                        android:id="@+id/btnCekChannel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_cek"
                        android:text="Cek channel" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Kartu">
                <TextView
                    style="@style/JudulKartu"
                    android:drawableStart="@drawable/ic_perisai"
                    android:text="Penjaga grup" />
                <TextView style="@style/KetKartu" android:text="Buat grup yang pakai &quot;Setujui anggota baru&quot;: yang minta join otomatis di-approve, KECUALI yang dulu udah keluar / dikeluarin. Akun WA lo harus admin di grup itu." />
                <LinearLayout android:id="@+id/rowGrupAktif" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nyalain penjaga grup"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Approve / tolak permintaan join otomatis"
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
                <TextView style="@style/Label" android:text="Link undangan grup" />
                <EditText
                    android:id="@+id/etGrup"
                    style="@style/Isian"
                    android:hint="https://chat.whatsapp.com/…"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
                <TextView style="@style/Label" android:text="Cek grup tiap (menit)" />
                <EditText
                    android:id="@+id/etGrupInterval"
                    style="@style/Isian"
                    android:hint="5"
                    android:importantForAutofill="no"
                    android:inputType="number" />
                <TextView style="@style/Label" android:text="Selalu tolak nomor ini" />
                <EditText
                    android:id="@+id/etGrupHitam"
                    style="@style/Isian"
                    android:hint="0812…, 0813… (pisah koma / baris)"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:singleLine="false"
                    android:minLines="2"
                    android:gravity="top|start" />
                <LinearLayout android:id="@+id/rowPerintah" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Perintah di grup"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="!rules &amp; !menu buat semua, !info khusus admin"
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowSamarkan" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Samarkan nomor di !info"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Daftar hitam yang dikirim ke grup jadi +62812****7890"
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
                <TextView style="@style/Label" android:text="Link aturan grup" />
                <EditText
                    android:id="@+id/etLinkRules"
                    style="@style/Isian"
                    android:hint="https://rules.xyc.my.id/"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
                <TextView style="@style/Label" android:text="Aturan singkat (1 baris = 1 poin, kosong = bawaan)" />
                <EditText
                    android:id="@+id/etRingkasRules"
                    style="@style/Isian"
                    android:hint="Keluar grup = permanen…"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:singleLine="false"
                    android:minLines="3"
                    android:gravity="top|start" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btnCekGrup"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_cek"
                        android:text="Cek sekarang" />
                    <TextView
                        android:id="@+id/btnResetHitam"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_hapus"
                        android:text="Kosongin hitam" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Kartu">
                <TextView
                    style="@style/JudulKartu"
                    android:drawableStart="@drawable/ic_script"
                    android:text="Script bot" />
                <TextView style="@style/KetKartu" android:text="Tambah perintah sendiri pakai file JavaScript (.js). Berlaku di grup yang dijaga &amp; chat &quot;Pesan ke diri sendiri&quot;." />
                <LinearLayout
                    android:id="@+id/wadahScript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btnUploadScript"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/TombolGaris"
                        android:drawableStart="@drawable/ic_upload"
                        android:text="Upload .js" />
                    <TextView
                        android:id="@+id/btnContohScript"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_script"
                        android:text="Contoh" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Kartu">
                <TextView
                    style="@style/JudulKartu"
                    android:drawableStart="@drawable/ic_batre"
                    android:text="Batre &amp; nyala otomatis" />
                <TextView style="@style/KetKartu" android:text="Biar nggak dibunuh sistem (apalagi di Xiaomi), izinkan dua hal di bawah." />
                <LinearLayout android:id="@+id/rowBoot" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nyala otomatis pas HP nyala"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Nggak perlu buka app habis restart"
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowLogcat" style="@style/BarisSaklar">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rekam log detail (debug)"
                            android:textColor="@color/wr_teks"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Matiin kalau udah lancar — sedikit lebih hemat"
                            android:textColor="@color/wr_teks2"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView style="@style/Saklar" />
                </LinearLayout>
                <TextView
                    android:id="@+id/btnBatre"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_batre"
                    android:layout_marginTop="12dp"
                    android:text="Izinkan jalan di latar (batre)" />
                <TextView
                    android:id="@+id/btnAutostart"
                    style="@style/TombolLembut"
                    android:drawableStart="@drawable/ic_power"
                    android:layout_marginTop="10dp"
                    android:text="Buka izin Autostart (Xiaomi dll)" />
                <TextView
                    android:id="@+id/tvBatreStat"
                    style="@style/KetKartu"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <LinearLayout style="@style/Kartu">
                <TextView
                    style="@style/JudulKartu"
                    android:drawableStart="@drawable/ic_log"
                    android:text="Log" />
                <TextView style="@style/KetKartu" android:text="File log disimpen di folder ini (bisa dibuka file manager):" />
                <TextView
                    android:id="@+id/tvFolderLog"
                    style="@style/KetKartu"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btnBukaLog"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_folder"
                        android:text="Buka folder" />
                    <TextView
                        android:id="@+id/btnKirimLog"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_bagi"
                        android:text="Kirim log" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Kartu">
                <TextView
                    style="@style/JudulKartu"
                    android:drawableStart="@drawable/ic_info"
                    android:text="Tentang" />
                <TextView
                    android:id="@+id/tvTentangVersi"
                    style="@style/KetKartu"
                    android:layout_marginTop="6dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btnTentang"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_info"
                        android:text="Tentang &amp; lisensi" />
                    <TextView
                        android:id="@+id/btnSambutan"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        style="@style/TombolLembut"
                        android:drawableStart="@drawable/ic_logo"
                        android:text="Panduan awal" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_banner"
        android:elevation="8dp"
        android:padding="14dp"
        android:textColor="@color/wr_teks"
        android:textSize="14sp"
        android:visibility="gone" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F20B141A"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">
        <TextView
            android:id="@+id/btnSave"
            style="@style/TombolUtama"
            android:drawableStart="@drawable/ic_simpan"
            android:text="Simpan setelan" />
    </FrameLayout>
</FrameLayout>
