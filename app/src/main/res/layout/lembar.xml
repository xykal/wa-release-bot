<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog buatan sendiri (pengganti AlertDialog bawaan). Isinya diisi dari
     MainActivity.lembar(): judul, pesan, view tambahan, dan tombol. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/bg_lembar"
        android:orientation="vertical"
        android:padding="22dp">
        <TextView
            android:id="@+id/lbJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wr_teks"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/lbPesan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/wr_teks2"
            android:textSize="14sp" />
        <FrameLayout
            android:id="@+id/lbIsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />
        <LinearLayout
            android:id="@+id/lbTombol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
