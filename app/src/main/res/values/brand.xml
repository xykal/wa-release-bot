<?xml version="1.0" encoding="utf-8"?>
<!-- Satu-satunya sumber string brand di sisi Android. Nilainya harus sama
     dengan bot-js/src/config/brand.mjs; CI (code-quality, job android-statis)
     menolak literal brand di layout. Brand tidak diterjemahkan; "Powered by"
     sudah Inggris, jadi tidak diberi padanan di values-en (lint MissingTranslation
     diabaikan supaya brand tetap satu sumber). -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="brand_name" translatable="false">XyVerse Technology Global</string>
    <string name="brand_powered_by_prefix" tools:ignore="MissingTranslation">POWERED BY</string>
    <string name="brand_powered_by" tools:ignore="MissingTranslation">Powered by XyVerse Technology Global</string>
    <string name="brand_author" translatable="false">xykal — XyVerse Technology Global</string>
</resources>
